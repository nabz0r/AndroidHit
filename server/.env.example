# Public resource identifiers only. No downloaded service-account JSON/key file.
GOOGLE_CLOUD_PROJECT=luma-drift-production
PLAY_PACKAGE_NAME=com.androidhit.lumadrift
SERVICE_URL=https://YOUR_CANONICAL_SERVICE_URL.run.app
PUBSUB_PUSH_SERVICE_ACCOUNT=luma-rtdn@luma-drift-production.iam.gserviceaccount.com
SCHEDULER_SERVICE_ACCOUNT=luma-scheduler@luma-drift-production.iam.gserviceaccount.com
RTDN_SUBSCRIPTION=projects/luma-drift-production/subscriptions/luma-rtdn
ALLOWED_WEB_ORIGINS=https://nabz0r.github.io
AUDIT_RETENTION_DAYS=365
# True supports Google Play license-test cards alongside real purchases.
ALLOW_TEST_PURCHASES=true
PORT=8080

# Prepared only: keep false until country, Play, age and payment qualification is complete.
PAID_COSMETIC_DRAWS_ENABLED=false
