{
  "headers": [
    {
      "glob": "**",
      "headers": {
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      }
    },
    {
      "glob": "/site-config.js",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "glob": "/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "glob": "**/*.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
